<mvc:View
	controllerName="fi.neomore.template.controller.App"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	displayBlock="true"
	height="100%">
	<App id="rootApp">
		<Page id="chatPage" title="{i18n>CHAT_TITLE}">
			<headerContent>
				<HBox alignItems="Center" visible="{view>/registered}">
					<Avatar
						src="{view>/avatarUrl}"
						initials="{view>/initials}"
						displaySize="XS"
						class="sapUiTinyMarginEnd" />
					<Text text="{view>/displayName}" class="sapUiTinyMarginEnd" />
					<Button
						icon="sap-icon://heart-2"
						type="Transparent"
						tooltip="{i18n>HEARTBEAT_BUTTON}"
						press=".onHeartbeat" />
					<Button
						icon="sap-icon://edit"
						type="Transparent"
						tooltip="{i18n>EDIT_PROFILE_BUTTON}"
						press=".onReopenRegistration" />
				</HBox>
			</headerContent>
			<content>
				<List
					id="messageList"
					items="{ path: '/Feed', sorter: { path: 'timestamp' }, filters: [ { path: 'eventType', operator: 'EQ', value1: 'chat.message.sent' } ] }"
					noDataText="{i18n>NO_MESSAGES}"
					showSeparators="None">
					<CustomListItem>
						<HBox class="workshopMessageRow sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginTop">
							<Avatar
								src="{ path: 'participantId', formatter: '.formatAvatarUrl' }"
								initials="{ path: 'displayName', formatter: '.formatInitials' }"
								displaySize="S"
								class="sapUiSmallMarginEnd" />
							<VBox class="workshopMessageContent">
								<HBox class="workshopMessageHeader" justifyContent="SpaceBetween" alignItems="Center">
									<Title text="{displayName}" level="H6" />
									<Button
										icon="sap-icon://response"
										type="Transparent"
										tooltip="{i18n>REPLY_BUTTON}"
										press=".onReply" />
								</HBox>
								<VBox
									visible="{ path: 'metadata', formatter: '.formatHasReply' }"
									class="workshopReplyReference sapUiTinyMarginBottom">
									<Text text="{ path: 'metadata', formatter: '.formatReplyTitle' }" class="workshopReplyTitle" />
									<Text text="{ path: 'metadata', formatter: '.formatReplyMessage' }" maxLines="2" />
								</VBox>
								<!-- TODO(workshop): Render preserved message line breaks. -->
								<Text text="{message}" wrapping="true" class="workshopMessageText" />
							</VBox>
						</HBox>
					</CustomListItem>
				</List>
			</content>
			<footer>
				<Toolbar>
					<VBox width="100%" class="workshopComposerField">
						<HBox
							visible="{view>/replying}"
							class="workshopReplyComposer"
							justifyContent="SpaceBetween"
							alignItems="Center">
							<VBox class="workshopReplyComposerText">
								<Text text="{view>/replyToLabel}" class="workshopReplyTitle" />
								<Text text="{view>/replyToMessage}" maxLines="1" />
							</VBox>
							<Button
								icon="sap-icon://decline"
								type="Transparent"
								tooltip="{i18n>CANCEL_REPLY_BUTTON}"
								press=".onCancelReply" />
						</HBox>
						<TextArea
							id="messageInput"
							value="{view>/newMessage}"
							placeholder="{i18n>MESSAGE_PLACEHOLDER}"
							growing="true"
							growingMaxLines="3"
							rows="1"
							width="100%"
							enabled="{view>/registered}" />
						<layoutData>
							<OverflowToolbarLayoutData maxWidth="100%" shrinkable="true" priority="NeverOverflow" />
						</layoutData>
					</VBox>
					<Button
						text="{i18n>SEND_BUTTON}"
						type="Emphasized"
						icon="sap-icon://paper-plane"
						press=".onSend"
						enabled="{view>/registered}">
						<layoutData>
							<OverflowToolbarLayoutData priority="NeverOverflow" />
						</layoutData>
					</Button>
				</Toolbar>
			</footer>
		</Page>
	</App>
</mvc:View>
